---
import '@fontsource-variable/montserrat';
import '@fontsource-variable/noto-sans';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/tokens.css';
import '../styles/landing.css';
const { title = 'Mercado Patagónico · Abastecimiento hotelero y gastronómico', description = 'Plataforma de abastecimiento hotelero y gastronómico para Magallanes: un solo operador, múltiples proveedores, una solución integral.' } = Astro.props;
const url = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const imagen = Astro.site ? new URL('/og.png', Astro.site).href : '/og.png';
const ld = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Mercado Patagónico',
  description,
  areaServed: 'Región de Magallanes, Chile',
  ...(Astro.site ? { url: Astro.site.href, logo: new URL('/favicon.svg', Astro.site).href } : {}),
});
---
<!doctype html>
<html lang="es" data-lang="es" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    {url && <link rel="canonical" href={url} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mercado Patagónico" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {url && <meta property="og:url" content={url} />}
    <meta property="og:image" content={imagen} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Mercado Patagónico: abastecimiento hotelero y gastronómico para Magallanes" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imagen} />
    <script type="application/ld+json" set:html={ld} />
    <meta name="theme-color" content="#F6F8F9" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          var l = localStorage.getItem('mp-lang'), t = localStorage.getItem('mp-theme');
          d.dataset.lang = l === 'en' ? 'en' : 'es';
          d.lang = d.dataset.lang;
          d.dataset.theme = t === 'dark' ? 'dark' : 'light';
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#que-es">Saltar al contenido</a>
    <slot />
    <div class="toast" role="status" aria-live="polite" id="toast"></div>
    <script>
      import '../scripts/interact.js';
    </script>
  </body>
</html>
