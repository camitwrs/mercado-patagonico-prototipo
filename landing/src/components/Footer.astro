---
import Bi from './Bi.astro';
import Logo from './Logo.astro';
// Mismo orden que el menú y las secciones de la página.
const year = new Date().getFullYear();
const links =[['que-es', 0], ['para-quien', 2], ['como-funciona', 1], ['preguntas', 3]];
---
<footer class="footer">
  <div class="wrap foot-in">
    <div class="foot-top">
      <a class="foot-logo" href="#top" aria-label="Mercado Patagónico"><Logo dark /></a>
      <nav class="foot-links" aria-label="Pie de página">
        {links.map(([id, k]) => <a href={`#${id}`}><Bi f={(X) => X.nav[k]} /></a>)}
        <a href="#contacto"><Bi f={(X) => X.contact} /></a>
      </nav>
    </div>
    <div class="foot-bot">
      <p>
        <span class="l-es">© {year} Mercado Patagónico. Desarrollado por Latitud53. Todos los derechos reservados.</span>
        <span class="l-en">© {year} Mercado Patagónico. Developed by Latitud53. All rights reserved.</span>
      </p>
      <span class="foot-lang" role="group" aria-label="Idioma / Language"><button type="button" data-set-lang="es" lang="es" aria-label="Español">ES</button><span aria-hidden="true">|</span><button type="button" data-set-lang="en" lang="en" aria-label="English">EN</button></span>
    </div>
  </div>
</footer>
