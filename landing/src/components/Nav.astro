---
import Bi from './Bi.astro';
import Logo from './Logo.astro';
import { RUTA, UI, otro } from '../lib/i18n.js';
// Mismo orden que las secciones de la página. El segundo valor es el índice de la etiqueta en content.json.
// URL de la plataforma: en producción será la dirección real de la app; hoy vive bajo /app/.
const { lang = 'es' } = Astro.props;
const t = UI[lang];
const appUrl = import.meta.env.PUBLIC_APP_URL || '/app/login';
const links = [['que-es', 0], ['para-quien', 2], ['como-funciona', 1], ['preguntas', 3]];
---
<header class="nav" id="top">
  <div class="wrap nav-in">
    <a class="nav-logo" href="#top" aria-label="Mercado Patagónico"><Logo /></a>
    <nav class="nav-links" aria-label={t.principal}>
      {links.map(([id, k]) => <a href={`#${id}`} data-spy={id}><Bi f={(X) => X.nav[k]} /></a>)}
    </nav>
    <div class="nav-cta">
      <a class="btn btn-o" href="#contacto"><Bi f={(X) => X.contact} /></a>
      <a class="btn btn-p" href={appUrl} data-login><Bi f={(X) => X.login} /></a>
      <div class="tools">
        <a class="tool" href={RUTA[otro(lang)]} hreflang={otro(lang)} lang={otro(lang)} data-lang-link={otro(lang)} aria-label={t.cambiarA} title={t.cambiarA}>{otro(lang).toUpperCase()}</a>
        <button class="tool" type="button" data-theme-toggle aria-label={t.tema}>
          <svg class="i-sun" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="i-moon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"/></svg>
        </button>
      </div>
    </div>
    <button class="nav-burger" type="button" data-menu-btn aria-expanded="false" aria-label={t.menu}><i></i><i></i><i></i></button>
  </div>
</header>
