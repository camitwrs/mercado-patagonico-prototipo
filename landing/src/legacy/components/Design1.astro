---
// Diseño 1 · Bodega y despacho: la propuesta elegida por la clienta, adaptada a su marca (logo, colores y textos de /documentacion).
import '@fontsource-variable/montserrat';
import '@fontsource-variable/noto-sans';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import Bi from './Bi.astro';
import Nav from './Nav.astro';
import HeroText from './HeroText.astro';
import QueEs from './QueEs.astro';
import Faq from './Faq.astro';
import ContactForm from './ContactForm.astro';
import Footer from './Footer.astro';
import LogoImg from './LogoImg.astro';
import { Image } from 'astro:assets';
import imgHotel from '../assets/seg/hotel.jpg';
import imgLodge from '../assets/seg/lodge.jpg';
import imgCadena from '../assets/seg/cadena.jpg';
import I18N from '../data/i18n.json';
import { palletSVG, barcodeSVG, iconSVG, truckSVG } from '../lib/svg.js';
import { cordilleraSVG, keyTagSVG } from '../lib/svg-sur.js';
const segIcons = ['hotel', 'lodge', 'cutlery', 'compass', 'cloche'];
const segImgs = [imgHotel, imgLodge, imgCadena];
const valIcons = ['basket', 'compass', 'box', 'snow', 'truck', 'scan'];
const noteIcons = ['snow', 'scan', 'box'];

const pallet = palletSVG(400);
const palletS = palletSVG(190);
const palletM = palletSVG(250);
const bar = barcodeSVG(300, 54, '#001F3B');
const barCta = barcodeSVG(170, 36, 'currentColor');
const ridge = cordilleraSVG();
const keyTag = keyTagSVG('#BE6844');
---
<div class="d d1">
  <Nav><LogoImg w={190} /></Nav>

  <div class="hero-scene" data-zone>
  <div class="cord-w" aria-hidden="true" set:html={ridge} />
  <i class="mist m1" aria-hidden="true"></i><i class="mist m2" aria-hidden="true"></i>
  <section class="hero wrap d1-hero">
    <HeroText title={(X) => X.h6} />
    <div class="hero-vis">
      <div class="pallet" set:html={pallet} />
      <div class="slw" data-reveal="drop" style="--i:2">
        <div class="keytag" aria-hidden="true" set:html={keyTag} />
        <article class="label" tabindex="0">
          <header>
            <span><Bi f={(X) => X.dispTitle} /></span>
            <code>MP-0001</code>
          </header>
          <div class="lb">
            <div class="lr"><small><Bi f={(X) => X.dispFrom} /></small><b>Santiago · Puerto Montt</b></div>
            <div class="lr"><small><Bi f={(X) => X.dispTo} /></small><b>Magallanes</b></div>
            <div class="lr"><small><Bi f={(X) => X.dispFor} /></small>
              <ul class="segs">
                {I18N.es.tags.map((_, i) => <li><span set:html={iconSVG(segIcons[i], 20, 'currentColor')} /><Bi f={(X) => X.tags[i]} /></li>)}
              </ul>
            </div>
            <span class="stamp" aria-hidden="true"><span class="l-es">Cadena de frío</span><span class="l-en">Cold chain</span></span>
            <div class="scan" set:html={bar} />
          </div>
        </article>
      </div>
    </div>
  </section>
  </div>

  <section class="prob-w" id="problema">
    <div class="wrap prob">
      <header class="sec-h">
        <span class="kick" data-reveal><Bi f={(X) => X.probKicker} /></span>
        <h2 data-reveal><Bi f={(X) => X.probTitle} /></h2>
        <p data-reveal style="--i:1"><Bi f={(X) => X.probSub} /></p>
      </header>
      <div class="prob-grid">
        {I18N.es.prob.map((_, i) => (
          <article class="prob-c" data-reveal style={`--i:${i}`}>
            <span class="prob-n">0{i + 1}</span>
            <h3><Bi f={(X) => X.prob[i][0]} /></h3>
            <p><Bi f={(X) => X.prob[i][1]} /></p>
          </article>
        ))}
      </div>
      <p class="sec-close" data-reveal><Bi f={(X) => X.probClose} /></p>
    </div>
  </section>

  <section class="val-w" id="valor">
    <div class="wrap val">
      <header class="sec-h">
        <span class="kick" data-reveal><Bi f={(X) => X.valKicker} /></span>
        <h2 data-reveal><Bi f={(X) => X.valTitle} /></h2>
        <p data-reveal style="--i:1"><Bi f={(X) => X.valSub} /></p>
      </header>
      <div class="val-grid">
        {I18N.es.val.map((_, i) => (
          <article class="val-c" data-reveal style={`--i:${i}`} tabindex="0">
            <span class="val-ic" set:html={iconSVG(valIcons[i], 28, 'currentColor')} />
            <h3><Bi f={(X) => X.val[i][0]} /></h3>
            <p><Bi f={(X) => X.val[i][1]} /></p>
          </article>
        ))}
      </div>
      <p class="sec-close" data-reveal><Bi f={(X) => X.valClose} /></p>
    </div>
  </section>

  <QueEs>
    <div class="pal-w" aria-hidden="true" data-live><div class="pal" set:html={palletS} /></div>
  </QueEs>

  <section class="op-w" id="como-funciona">
    <div class="wrap op">
      <header class="sec-h">
        <span class="kick" data-reveal><Bi f={(X) => X.opKicker} /></span>
        <h2 data-reveal><Bi f={(X) => X.opTitle} /></h2>
        <p data-reveal style="--i:1"><Bi f={(X) => X.opSub} /></p>
      </header>
      <ol class="ops" data-live>
        {I18N.es.ops.map((_, i) => (
          <li class="op-s" style={`--i:${i}`} data-reveal>
            <span class="op-n">0{i + 1}</span>
            <h3><Bi f={(X) => X.ops[i][0]} /></h3>
            <p><Bi f={(X) => X.ops[i][1]} /></p>
          </li>
        ))}
      </ol>
      <div class="op-notes">
        {I18N.es.opNotes.map((_, i) => (
          <div class="op-note" data-reveal style={`--i:${i}`}>
            <span set:html={iconSVG(noteIcons[i], 22, 'currentColor')} />
            <div><b><Bi f={(X) => X.opNotes[i][0]} /></b><small><Bi f={(X) => X.opNotes[i][1]} /></small></div>
          </div>
        ))}
      </div>
      <div class="partners" data-reveal>
        <small><Bi f={(X) => X.partnersLabel} /></small>
        <ul class="chips">
          {I18N.es.partners.map((_, i) => <li class="chip"><Bi f={(X) => X.partners[i]} /></li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="lvl-w" id="niveles">
    <div class="wrap lvl">
      <header class="sec-h">
        <span class="kick" data-reveal><Bi f={(X) => X.lvlKicker} /></span>
        <h2 data-reveal><Bi f={(X) => X.lvlTitle} /></h2>
        <p data-reveal style="--i:1"><Bi f={(X) => X.lvlSub} /></p>
      </header>
      <div class="lvl-grid">
        {I18N.es.lvls.map((l, i) => (
          <article class={`lvl-c lvl-${i + 1}`} data-reveal style={`--i:${i}`} tabindex="0">
            <header><span class="lvl-no">0{i + 1}</span><h3><Bi f={(X) => X.lvls[i][0]} /></h3></header>
            <ul>
              {l[1].map((_, k) => <li><Bi f={(X) => X.lvls[i][1][k]} /></li>)}
            </ul>
            <footer><Bi f={(X) => X.lvls[i][2]} /></footer>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="rel-w" id="acompanamiento">
    <div class="wrap rel">
      <div class="rel-l">
        <header class="sec-h">
          <span class="kick" data-reveal><Bi f={(X) => X.relKicker} /></span>
          <h2 data-reveal><Bi f={(X) => X.relTitle} /></h2>
        </header>
        <ul class="rel-list">
          {I18N.es.rel.map((_, i) => (
            <li data-reveal="left" style={`--i:${i}`}><i>0{i + 1}</i><div><b><Bi f={(X) => X.rel[i][0]} /></b><span><Bi f={(X) => X.rel[i][1]} /></span></div></li>
          ))}
        </ul>
      </div>
      <div class="rel-r">
        <header class="sec-h">
          <h2 data-reveal><Bi f={(X) => X.kpiTitle} /></h2>
          <p data-reveal style="--i:1"><Bi f={(X) => X.kpiSub} /></p>
        </header>
        <div class="kpis">
          {I18N.es.kpis.map((_, i) => (
            <div class="kpi" data-reveal="zoom" style={`--i:${i}`}><b><Bi f={(X) => X.kpis[i][0]} /></b><span><Bi f={(X) => X.kpis[i][1]} /></span></div>
          ))}
        </div>
        <p class="kpi-note" data-reveal><Bi f={(X) => X.kpiNote} /></p>
      </div>
    </div>
  </section>

  <section class="seg-w" id="para-quien">
    <div class="wrap segm">
      <header class="seg-h">
        <h2 data-reveal="left"><Bi f={(X) => X.paraTitle} /></h2>
        <p data-reveal style="--i:1"><Bi f={(X) => X.paraSub} /></p>
      </header>
      <div class="seg-grid">
        {segImgs.map((img, i) => (
          <article class="seg-c" data-reveal style={`--i:${i}`} tabindex="0">
            <div class="seg-ph">
              <Image src={img} width={760} alt="" loading="lazy" />
              <span class="seg-tag"><Bi f={(X) => X.segCards[i][0]} /></span>
            </div>
            <div class="seg-b">
              <h3><Bi f={(X) => X.segCards[i][1]} /></h3>
              <p><Bi f={(X) => X.segCards[i][2]} /></p>
            </div>
          </article>
        ))}
      </div>
      <div class="seg-more" data-reveal>
        <p><Bi f={(X) => X.segMore} /></p>
        <a class="btn btn-p" href="#contacto"><Bi f={(X) => X.paraBtn} /><span class="arr" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
  <section class="how-w" id="pasos">
    <div class="how wrap">
      <div class="how-ridge" aria-hidden="true" set:html={ridge} />
      <h2 data-reveal><Bi f={(X) => X.stepsTitle1} /></h2>
      <div class="route" data-live aria-hidden="true">
        <span>Santiago</span>
        <i class="rt-line"><i class="rt-truck" set:html={truckSVG(32, 'currentColor')} /></i>
        <span>Magallanes</span>
      </div>
      <ol class="track" data-live>
        {I18N.es.steps.map((_, i) => (
          <li class="stage" style={`--i:${i}`} data-reveal>
            <div class="st-h"><span class="node">{i + 1}</span>{i < 3 && <i class="seg"></i>}</div>
            <div class="st-b">
              <h3><Bi f={(X) => X.steps[i][0]} /></h3>
              <p><Bi f={(X) => X.steps[i][1]} /></p>
            </div>
          </li>
        ))}
      </ol>
      <div class="pilot" data-live>
        <header class="sec-h">
          <span class="kick" data-reveal><Bi f={(X) => X.pilotKicker} /></span>
          <h2 data-reveal><Bi f={(X) => X.pilotTitle} /></h2>
          <p data-reveal style="--i:1"><Bi f={(X) => X.pilotSub} /></p>
        </header>
        <div class="pil-grid">
          {I18N.es.pilot.map((_, i) => (
            <div class="pil" style={`--i:${i}`} data-reveal>
              <div class="pil-h"><span class="pil-node">✓</span>{i < 2 && <i class="pil-line"></i>}</div>
              <small><Bi f={(X) => X.pilot[i][0]} /></small>
              <h3><Bi f={(X) => X.pilot[i][1]} /></h3>
              <p><Bi f={(X) => X.pilot[i][2]} /></p>
            </div>
          ))}
        </div>
        <p class="sec-close sec-close-dark" data-reveal><Bi f={(X) => X.pilotClose} /></p>
      </div>
    </div>
  </section>

  <Faq tag="ficha" />

  <section class="cta-w" id="contacto">
    <div class="cta wrap">
      <div class="cta-l">
        <span class="cta-bar" data-reveal="left" set:html={barCta} />
        <h2 data-reveal style="--i:1"><Bi f={(X) => X.ctaTitle1} /></h2>
        <p data-reveal style="--i:2"><Bi f={(X) => X.ctaText} /></p>
      </div>
      <ContactForm />
    </div>
  </section>

  <Footer><LogoImg w={170} plate /></Footer>
</div>

<style is:global>
  .d1 {
    --bg: #F6F8F7; --bg2: #E2EEF0; --emph: #001F3B; --fg: #001F3B; --mut: #4B6070; --ridge1: #CADDE8; --ridge2: #9CC3DA; --ridge3: #5E9FC4;
    --btn-bg: #001F3B; --btn-fg: #FFFFFF; --accent: #BE6844; --naranja: #BE6844; --teal: #009BA0; --azul: #004674;
    --f-head: 'Montserrat Variable', sans-serif; --f-headmd: var(--f-head); --f-body: 'Noto Sans Variable', sans-serif; --f-bodymd: var(--f-body);
    --f-mono: 'IBM Plex Mono', monospace;
    --r-btn: 2px; --r-chip: 2px; --r-panel: 2px; --r-form: 2px; --r-field: 2px;
    --form-bg: var(--bg2); --field-bg: var(--bg); --f-sub: var(--f-body);
  }
  html[data-theme="dark"] .d1 {
    --bg: #061B2E; --bg2: #0B2840; --emph: #031220; --fg: #EAF1F4; --mut: #9FB3C0; --btn-bg: #C8734A; --btn-fg: #04141F;
    --ridge1: #123650; --ridge2: #1C4C6E; --ridge3: #2A6690;
  }
  .d1 h1, .d1 h2, .d1 h3 { font-weight: 700; }
  .d1 .btn, .d1 .nav-links a { font-weight: 600; }
  .d1 .hero-title { font-family: var(--f-head); font-size: clamp(34px, 4.2vw, 60px); line-height: 1.1; letter-spacing: -.02em; font-weight: 700; }
  .d1 .hero-body { font-size: 18px; }
  .d1 .logo-plate { display: inline-flex; border-radius: 10px; transition: transform .35s cubic-bezier(.3,1.4,.5,1); }
  .d1 .logo-img { display: block; height: auto; mix-blend-mode: multiply; }
  .d1 .nav-logo:hover .logo-plate { transform: scale(1.04); }
  html[data-theme="dark"] .d1 .nav .logo-plate, .d1 .logo-plate.plate { background: #fff; padding: 6px 12px; }
  html[data-theme="dark"] .d1 .nav .logo-img, .d1 .logo-plate.plate .logo-img { mix-blend-mode: normal; }
  .d1-hero { padding-block: 56px 72px; }

  /* cordillera, niebla y llavero de hotel */
  .d1 .hero-scene { position: relative; overflow: hidden; --mx: 0; --my: 0; }
  .d1 .hero-scene > .hero { position: relative; z-index: 1; }
  .d1 .hero-scene::before { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse 60% 55% at 78% 30%, rgba(170,200,212,.5), transparent 70%); pointer-events: none; }
  html[data-theme="dark"] .d1 .hero-scene::before { background: radial-gradient(ellipse 60% 55% at 78% 30%, rgba(60,100,115,.35), transparent 70%); }
  .d1 .cord-w { position: absolute; inset: 0; pointer-events: none; -webkit-mask-image: linear-gradient(to right, transparent 40%, #000 70%), linear-gradient(to bottom, #000 82%, transparent); -webkit-mask-composite: source-in; mask-image: linear-gradient(to right, transparent 40%, #000 70%), linear-gradient(to bottom, #000 82%, transparent); mask-composite: intersect; }
  .d1 .cord-w svg { position: absolute; left: 0; bottom: 0; width: 100%; height: auto; max-height: 100%; overflow: visible; }
  .d1 .snow { fill: #fff; fill-opacity: .9; }
  .d1 .how-ridge, .d1 .para-ridge { -webkit-mask-image: linear-gradient(to right, transparent, #000 40%, #000 85%, transparent); mask-image: linear-gradient(to right, transparent, #000 40%, #000 85%, transparent); }
  .d1 .how-ridge .snow, .d1 .para-ridge .snow { fill-opacity: .12; }
  .d1 .rg { transition: transform .35s ease-out; }
  .d1 .r1 { transform: translateX(calc(var(--mx) * -5px)); } .d1 .r2 { transform: translateX(calc(var(--mx) * -10px)); } .d1 .r3 { transform: translateX(calc(var(--mx) * -16px)); }
  .d1 .mist { position: absolute; left: 30%; bottom: 110px; z-index: 0; width: 70%; height: 46px; border-radius: 50%; background: radial-gradient(ellipse at center, rgba(255,255,255,.7), transparent 70%); filter: blur(7px); animation: d1mist 16s ease-in-out infinite alternate; pointer-events: none; }
  .d1 .mist.m2 { bottom: 50px; left: 45%; width: 60%; animation-duration: 22s; animation-direction: alternate-reverse; opacity: .8; }
  html[data-theme="dark"] .d1 .mist { opacity: .12; }
  @keyframes d1mist { from { transform: translateX(-8%); } to { transform: translateX(22%); } }
  .d1 .keytag { position: absolute; left: -76px; top: -4px; width: 90px; z-index: 3; pointer-events: none; }
  .d1 .keytag svg { overflow: visible; transform-origin: 88px 14px; animation: d1key 4.5s ease-in-out infinite alternate; }
  @keyframes d1key { from { transform: rotate(-7deg); } to { transform: rotate(6deg); } }
  .d1 .para-ridge { position: absolute; right: 0; bottom: 0; width: 62%; height: 100%; opacity: .55; pointer-events: none; --ridge1: rgba(255,255,255,.04); --ridge2: rgba(255,255,255,.07); --ridge3: rgba(255,255,255,.1); }
  .d1 .para-ridge svg { width: 100%; height: 100%; }
  .d1 .para > .para-l, .d1 .para > .bul { position: relative; z-index: 1; }
  @media (max-width: 980px) { .d1 .keytag { display: none; } .d1 .cord-w { } .d1 .mist { display: none; } }

  /* etiqueta de despacho y pallet */
  .d1 .hero-vis { position: relative; height: 540px; }
  .d1 .pallet { position: absolute; left: 0; top: 190px; width: 400px; transform: translate(calc(var(--mx) * 8px), calc(var(--my) * 6px)); transition: transform .35s ease-out; }
  .d1 .pallet svg, .d1 .pal svg { width: 100%; height: auto; overflow: visible; }
  .d1 .pbox { animation: d1drop .7s cubic-bezier(.3,1.5,.5,1) both; transform-box: fill-box; transform-origin: center bottom; }
  .d1 .pallet .pbox:nth-of-type(1) { animation-delay: .1s; } .d1 .pallet .pbox:nth-of-type(2) { animation-delay: .25s; } .d1 .pallet .pbox:nth-of-type(3) { animation-delay: .4s; }
  .d1 .pallet .pbox:nth-of-type(4) { animation-delay: .6s; } .d1 .pallet .pbox:nth-of-type(5) { animation-delay: .75s; } .d1 .pallet .pbox:nth-of-type(6) { animation-delay: .95s; }
  .d1 .pal .pbox { animation: none; opacity: 0; }
  .d1 .pal-w.live .pbox { animation: d1drop .7s cubic-bezier(.3,1.5,.5,1) both; opacity: 1; }
  .d1 .pal-w.live .pbox:nth-of-type(1) { animation-delay: .1s; } .d1 .pal-w.live .pbox:nth-of-type(2) { animation-delay: .25s; } .d1 .pal-w.live .pbox:nth-of-type(3) { animation-delay: .4s; }
  .d1 .pal-w.live .pbox:nth-of-type(4) { animation-delay: .6s; } .d1 .pal-w.live .pbox:nth-of-type(5) { animation-delay: .75s; } .d1 .pal-w.live .pbox:nth-of-type(6) { animation-delay: .95s; }
  @keyframes d1drop { from { transform: translateY(-90px); opacity: 0; } 60% { opacity: 1; } to { transform: none; opacity: 1; } }
  .d1 .slw { position: absolute; left: 240px; top: 0; width: 340px; transform: rotate(2deg) translate(calc(var(--mx) * -10px), calc(var(--my) * -8px)); transition: transform .35s ease-out; }
  html .d1 .slw.in { transform: rotate(2deg) translate(calc(var(--mx) * -10px), calc(var(--my) * -8px)); }
  .d1 .label { background: #fff; color: #001F3B; border-radius: 4px; overflow: hidden; box-shadow: 0 12px 24px rgba(0,0,0,.22); transition: box-shadow .35s; outline-offset: 4px; }
  .d1 .label:hover { box-shadow: 0 24px 40px rgba(0,0,0,.3); }
  .d1 .label header { display: flex; justify-content: space-between; align-items: center; padding: 12px 18px; background: var(--naranja); }
  .d1 .label header span { font-family: var(--f-head); font-weight: 700; font-size: 17px; text-transform: uppercase; letter-spacing: .1em; line-height: 1.1; }
  .d1 .label code { font-family: var(--f-mono); font-size: 14px; font-weight: 500; }
  .d1 .lb { padding: 18px; display: flex; flex-direction: column; gap: 12px; }
  .d1 .lr { display: flex; flex-direction: column; gap: 3px; padding-bottom: 12px; border-bottom: 1.5px dashed rgba(0,31,59,.25); transition: transform .3s; }
  .d1 .lr:hover { transform: translateX(6px); }
  .d1 .lr small { font-family: var(--f-mono); font-size: 11px; text-transform: uppercase; letter-spacing: .08em; color: #5A6F7C; }
  .d1 .lr b { font-family: var(--f-head); font-weight: 700; font-size: 19px; line-height: 1.2; }
  .d1 .scan { position: relative; line-height: 0; overflow: hidden; }
  .d1 .scan svg { width: 100%; height: auto; }
  .d1 .scan::after { content: ''; position: absolute; top: -2px; bottom: -2px; left: 0; width: 3px; background: var(--naranja); box-shadow: 0 0 10px 2px rgba(190,104,68,.7); animation: d1scan 2.6s ease-in-out infinite; }
  .d1 .segs { display: flex; flex-wrap: wrap; gap: 8px 16px; }
  .d1 .segs li { display: inline-flex; align-items: center; gap: 6px; font-family: var(--f-head); font-weight: 600; font-size: 14px; line-height: 1.1; }
  .d1 .segs svg { color: var(--naranja); }
  .d1 .label { position: relative; }
  .d1 .stamp { position: absolute; right: 20px; top: 112px; padding: 4px 8px; border: 2px solid var(--naranja); border-radius: 3px; color: var(--naranja); font-family: var(--f-head); font-weight: 700; font-size: 12px; letter-spacing: .1em; text-transform: uppercase; text-align: center; line-height: 1.15; width: 92px; transform: rotate(-9deg); opacity: 0; pointer-events: none; }
  .d1 .slw.in .stamp { animation: d1stamp .5s 1.1s cubic-bezier(.3,1.6,.5,1) forwards; }
  @keyframes d1stamp { from { transform: rotate(-9deg) scale(2.4); opacity: 0; } to { transform: rotate(-9deg) scale(1); opacity: .95; } }
  @keyframes d1scan { 0% { left: 0; } 50% { left: calc(100% - 3px); } 100% { left: 0; } }
  @media (max-width: 980px) {
